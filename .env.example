# Copy to .env only on the deployment server. Do not commit .env or certificates.
SCMS_DEBUG=false
SCMS_SECRET_KEY=replace-with-a-long-random-production-secret
SCMS_ALLOWED_HOSTS=scms.example.edu

# Keep only on the deployment server or approved secret manager.
SCMS_BACKUP_PASSPHRASE=generate-a-long-random-passphrase
SCMS_BACKUP_UTC_HOUR=2
